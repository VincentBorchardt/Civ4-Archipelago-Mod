<?xml version="1.0" encoding="utf-8"?>
<mod id="Archipelago" 
     name="Civilization 4 Archipelago Mod" 
     author="Vincent" 
     version="0.1">

    <!-- Custom Archipelago Event Manager -->
    <event type="GameStart" module="ArchipelagoEvents" function="onGameStart"/>
    <event type="OnLoad" module="ArchipelagoEvents" function="onLoadGame"/>
    <event type="SaveGame" module="ArchipelagoData" function="saveData"/>
    <event type="EndPlayerTurn" module="ArchipelagoEvents" function="onEndPlayerTurn"/>
    <event type="buildingBuilt" module="ArchipelagoEvents" function="onBuildingBuilt"/>
    <event type="techAcquired" module="ArchipelagoEvents" function="onTechAcquired"/>
    <event type="ModNetMessage" module="ArchipelagoEvents" function="onModNetMessage"/>
    <event type="victory" module="ArchipelagoEvents" function="onVictory"/>

    <!-- The 'options' tag MUST have the 'file' attribute specified -->
    <!-- This creates Civ4ArchipelagoMod.ini inside the mod's UserSettings folder -->
    <options id="ArchipelagoOptions" file="Civ4ArchipelagoMod.ini">

        <section id="ProfileSettings">
            <option id="ArchipelagoServer" 
                    type="string" 
                    default="archipelago.gg"/>
            <option id="ArchipelagoUsername" 
                    type="string" 
                    default="Player1"/>
            <option id="ArchipelagoPassword" 
                    type="string" 
                    default="None"/>
	    <option id="ArchipelagoCommand" 
		    type="string"
		    default="None"/>
	    <option id="ShowAnnouncements" 
		    type="bool"
		    default="False"/>
        </section>
    </options>

</mod>
