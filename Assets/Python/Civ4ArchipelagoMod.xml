<?xml version="1.0" encoding="utf-8"?>
<mod id="Civ4ArchipelagoMod" 
     name="Civilization 4 Archipelago Mod" 
     author="Vincent" 
     version="0.1" 
     tweak="true">
    
    <!-- Step A: Tell BUG to load your custom Python script and attach its events -->
    <events module="ArchipelagoEventManager"/>

    <!-- Step B: Declare your user profile configuration options -->
    <section id="ProfileSettings">
        <option id="ArchipelagoServer" 
                type="text" 
                default="archipelago.gg:38281"
                get="getArchipelagoServer" 
                set="setArchipelagoServer"/>
        <option id="ArchipelagoUsername" 
                type="text" 
                default="Player1"
                get="getArchipelagoUsername" 
                set="setArchipelagoUsername"/>
        <option id="ArchipelagoPassword" 
                type="text" 
                default=""
                get="getArchipelagoPassword" 
                set="setArchipelagoPassword"/>
    </section>
</mod>